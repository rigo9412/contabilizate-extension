{
  "name": "contabilizate-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App iOS que automatiza el portal del SAT con la e.firma almacenada en el dispositivo",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=www/bundle.js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=www/bundle.js --watch",
    "sync": "npm run build && cap sync ios",
    "ios": "cap open ios",
    "run:ios": "npm run build && cap run ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capgo/capacitor-inappbrowser": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.2"
  }
}
