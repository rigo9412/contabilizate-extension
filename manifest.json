{
    "name": "Contabilizate",
    "description": "Factura en el portal del SAT y lleva tus ingresos, gastos e impuestos. Gratis y privado: tus datos se quedan en tu navegador.",
    "version": "2.1",
    "manifest_version": 3,
    "key": "",
    "permissions": [
        "scripting",
        "storage",
        "downloads",
        "unlimitedStorage",
        "identity"
    ],
    "host_permissions": [
        "https://*.sat.gob.mx/*",
        "https://portal.facturaelectronica.sat.gob.mx/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "128": "128.png"
        }
    },
    "icons": {
        "16": "128.png",
        "48": "128.png",
        "128": "128.png"
    },
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "oauth2": {
        "client_id": "__GOOGLE_CLIENT_ID__",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata"
        ]
    }
}
