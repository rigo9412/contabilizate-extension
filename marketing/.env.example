# Copia este archivo a marketing/.env (está en .gitignore) y llena solo las redes que uses.

# X: developer.x.com → tu app → Keys and tokens (permisos Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn: app con los productos "Share on LinkedIn" y "Sign In with LinkedIn using OpenID Connect",
# y http://localhost:8787/callback en Auth → Authorized redirect URLs.
# Llena el client ID y secret y corre marketing/linkedin-auth.mjs: él llena el token y el ID.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_TOKEN=
LINKEDIN_PERSON_ID=
# Opcional: versión de API YYYYMM. Por defecto usa el mes anterior.
LINKEDIN_VERSION=

# Threads: app de Meta con el caso de uso "Threads API", token largo (60 días)
# con permisos threads_basic y threads_content_publish.
THREADS_TOKEN=

# Facebook (página, no perfil personal ni grupos): app de Meta con permisos
# pages_show_list, pages_read_engagement y pages_manage_posts.
# En Graph API Explorer pide un token de usuario, cámbialo por uno largo y
# consulta /me/accounts: ahí salen el ID de la página y su token (no caduca).
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Opcional: versión de Graph API. Por defecto v24.0.
FB_GRAPH_VERSION=
